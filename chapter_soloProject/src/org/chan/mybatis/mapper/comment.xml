<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"https://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="org.chan.mybatis.mapper.comment">

	<!-- 댓글 작성 쿼리 -->
	<insert id="insert_comment" parameterType="org.chan.vo.CVO">
		INSERT INTO project_comment_t VALUES (project_comment_seq.nextval, #{writer}, #{content}, sysdate, #{b_idx})
	</insert>
	
	<!-- 댓글 출력 쿼리 -->
	<select id="get_comment_list" parameterType="int" resultType="org.chan.vo.CVO">
		SELECT * FROM project_comment_t WHERE b_idx=#{b_idx}
	</select>
	
	<!-- 댓글 수정 쿼리 -->
	<update id="update_comment" parameterType="org.chan.vo.CVO">
		UPDATE project_comment_t SET content=#{content} WHERE c_idx=#{c_idx}
	</update>
	
	<!-- 댓글 삭제 쿼리 -->
	<delete id="delete_comment" parameterType="int">
		DELETE FROM project_comment_t WHERE c_idx=#{c_idx}
	</delete>
	
	 <!-- 작성자로 댓글 가져오는 쿼리 -->
	 <select id="get_commentlist_with_user" parameterType="String" resultType="org.chan.vo.BCVO">
	 	SELECT b_idx, title, c.content AS content, c.reg_date AS reg_date FROM project_comment_t c 
	 	INNER JOIN project_bbs_t b USING(b_idx) WHERE c.writer=#{writer}
	 </select>
</mapper>