<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"https://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="org.chan.mybatis.mapper.member">

	<!-- 아이디 중복 확인을 위한 쿼리 -->
	<select id="validate_mId" parameterType="String" resultType="int">
		SELECT COUNT(*) FROM project_member_t WHERE mId=#{mId}
	</select>
	
	<!-- 닉네임 중복 확인을 위한 쿼리 -->
	<select id="validate_mName" parameterType="String" resultType="int">
		SELECT COUNT(*) FROM project_member_t WHERE mName=#{mName}
	</select>
	
	<!-- 회원 가입을 위한 쿼리 -->
	<insert id="join_member" parameterType="org.chan.vo.MVO">
		INSERT INTO project_member_t VALUES (project_member_seq.nextval, #{mId}, #{mPw}, #{mName}, sysdate)
	</insert>
	
	<!-- 로그인을 위한 쿼리 -->
	<select id="login" parameterType="org.chan.vo.MVO" resultType="String">
		SELECT mName FROM project_member_t WHERE mId=#{mId} and mPw=#{mPw}
	</select>
	
	<!-- 회원정보 수정을 위해 회원정보 조회 쿼리 -->
	<select id="get_member_info" parameterType="String" resultType="org.chan.vo.MVO">
		SELECT * FROM project_member_t WHERE mName=#{mName}
	</select>
	
	<!-- 회원정보 수정 전 비밀번호 확인을 위한 쿼리 -->
	<select id="validate_mPw" parameterType="org.chan.vo.MVO" resultType="int">
		SELECT COUNT(*) FROM project_member_t WHERE mPw=#{mPw} and mName=#{mName} 
	</select> 
	
	<!-- 회원정보 수정을 위한 쿼리 -->
	<update id="update_member" parameterType="org.chan.vo.MVO">
		UPDATE project_member_t SET mPw=#{mPw}, mName=#{mName} WHERE mId=#{mId}
	</update>
	
	<!-- 회원탈퇴를 위한 쿼리 -->
	<delete id="delete_member" parameterType="String">
		DELETE FROM project_member_t WHERE mName=#{mName}
	</delete>
</mapper>