<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"https://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="org.chan.mybatis.mapper.comment">
	<!-- 댓글 입력 -->
	<insert id="insert_comment" parameterType="org.chan.vo.CVO">
	 	INSERT INTO comment_t VALUES (comment_seq.nextval, #{writer}, #{content}, #{pw}, #{ip}, sysdate, #{b_idx}) 
	</insert>
	
	<!-- 댓글 출력 -->	
	<select id="commList" parameterType="int" resultType="org.chan.vo.CVO">
		SELECT * FROM comment_t WHERE b_idx=#{b_idx}
	</select>
	
	<!-- 댓글 삭제 -->
	<delete id="delete_comment" parameterType="int">
		DELETE FROM comment_t WHERE c_idx = #{c_idx}
	</delete>
</mapper>