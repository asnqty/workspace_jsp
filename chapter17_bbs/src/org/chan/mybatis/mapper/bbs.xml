<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="org.chan.mybatis.mapper.bbs">
	<!-- 모든 게시글 보기 -->
	<select id="bbs_select_all" resultType="org.chan.vo.BVO">
		SELECT * FROM bbs_t ORDER BY b_idx DESC
	</select>
	
	<!-- 게시글 작성 -->
	<insert id="insert_bbs" parameterType="org.chan.vo.BVO">
		INSERT INTO bbs_t VALUES (bbs_seq.nextval, #{writer}, #{title}, #{content}, #{pw}, 0, #{ip}, #{filename}, sysdate)
	</insert>
	
	<!-- 게시글 내용 보기 -->
	<select id="bbs_by_idx" parameterType="int" resultType="org.chan.vo.BVO">
		SELECT * FROM bbs_t WHERE b_idx = #{b_idx}
	</select>
	
	<!-- 게시글 삭제 -->
	<delete id="delete_bbs">
	 	DELETE FROM bbs_t WHERE b_idx = #{b_idx}
	</delete>
</mapper>






