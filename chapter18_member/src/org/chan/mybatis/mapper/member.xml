<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"https://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="org.chan.mybatis.mapper.bbs">
	<!-- 아이디 중복 확인용 쿼리 -->
	<select id="validate_id" parameterType="String" resultType="int">
		SELECT COUNT(*) FROM member_t WHERE mid=#{mId}
	</select>
	
	<!-- 회원가입용 인서트 쿼리 -->
	<insert id="insert_member" parameterType="org.chan.vo.MemberVO">
		INSERT INTO member_t VALUES (member_seq.nextval, #{mId}, #{mPw}, #{mName}, #{mEmail}, sysdate)
	</insert>
	
	<!-- 로그인시 기존 회원 확인용 쿼리 -->
	<select id="do_login" parameterType="org.chan.vo.MemberVO" resultType="org.chan.vo.MemberVO">
		SELECT * FROM member_t WHERE mid=#{mId} and mpw=#{mPw}
	</select>
</mapper>